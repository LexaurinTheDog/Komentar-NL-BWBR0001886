      <intitule>Besluit van 19 november 2025 tot vaststelling van het tijdstip van inwerkingtreding van de Wet versterking auteurscontractenrecht [KetenID WGK013342]</intitule>
      <wet-besluit>
         <aanhef>
            <wij>Wij Willem-Alexander, bij de gratie Gods, Koning der Nederlanden, Prins van Oranje-Nassau, enz. enz. enz.</wij>
            <considerans>
               <considerans.al bevat="voordracht">Op de voordracht van de Staatssecretaris van Justitie en Veiligheid van 12 november 2025, directie Wetgeving en Juridische Zaken, nr. 6849100;</considerans.al>
               <considerans.al bevat="grondslag">Gelet op artikel VI van de Wet versterking auteurscontractenrecht;</considerans.al>
            </considerans>
            <afkondiging>
               <al>Hebben goedgevonden en verstaan:</al>
            </afkondiging>
         </aanhef>
         <wettekst><?xpp qa?><?xpp lead;-1?><artikel status="goed">
               <kop>
                  <label>Enig</label>
                  <titel>artikel</titel>
               </kop>
               <al>De Wet versterking auteurscontractenrecht treedt in werking met ingang van 1 januari 2026.</al>
            </artikel>
         </wettekst>
         <wetsluiting status="goed">
            <slotformulering>
